# Copy to .env.local and fill in there. Never commit real values, never paste keys into chat.

# ---- Razorpay (use TEST keys until the whole flow has passed) ----
# Server only. The secret must never be sent to the browser or prefixed with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret you set in Razorpay Dashboard > Webhooks (different from the key secret).
RAZORPAY_WEBHOOK_SECRET=
# Browser-safe: the same Key ID as above (never the secret).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Live keys (rzp_live_...) are refused unless this is "true".
RAZORPAY_ALLOW_LIVE=false
# TEST MODE ONLY: amount per item in paise while WooCommerce prices are not connected
# (e.g. 100 = Rs 1). Ignored with live keys. Never shown as a product price.
CHECKOUT_TEST_UNIT_PRICE_PAISE=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=

# ---- Website enquiries (server only; never NEXT_PUBLIC_) ----
# Where B2B enquiries (/b2b) and contact messages (/contact) are POSTed as JSON: a CRM, automation
# (e.g. Zapier/Make) or mail-service endpoint. Unset in development = saved to .data/*.json (git-ignored);
# unset in production = the forms show the phone/email instead of accepting messages.
B2B_LEADS_WEBHOOK_URL=
B2B_LEADS_WEBHOOK_TOKEN=
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
